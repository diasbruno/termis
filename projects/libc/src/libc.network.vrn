(import libc.types :as types)

;; Socket creation, address conversion, connection, and byte-stream I/O.
(external-function socket "socket" (types:c-int types:c-int types:c-int) types:file-descriptor)
(external-function htons "htons" (u16) u16)
(external-function inet-addr "inet_addr" (types:c-string) u32)
(external-function setsockopt "setsockopt" (types:file-descriptor types:c-int types:c-int (pointer void) types:socket-length-t) types:c-int)
(external-function bind "bind" (types:file-descriptor (pointer types:socket-address) types:socket-length-t) types:c-int)
(external-function listen "listen" (types:file-descriptor types:c-int) types:c-int)
(external-function accept "accept" (types:file-descriptor (pointer types:socket-address) (pointer types:socket-length-t)) types:file-descriptor)
(external-function connect "connect" (types:file-descriptor (pointer types:socket-address) types:socket-length-t) types:c-int)
(external-function send "send" (types:file-descriptor (pointer void) types:size-t types:c-int) types:ssize-t)
(external-function recv "recv" (types:file-descriptor (pointer void) types:size-t types:c-int) types:ssize-t)
(external-function getaddrinfo "getaddrinfo" (types:c-string types:c-string (pointer types:address-info) (pointer (pointer types:address-info))) types:c-int)
(external-function freeaddrinfo "freeaddrinfo" ((pointer types:address-info)) void)

(export socket htons inet-addr setsockopt bind listen accept connect send recv getaddrinfo freeaddrinfo)
