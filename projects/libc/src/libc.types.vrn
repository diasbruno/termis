;; C scalar aliases preserve the platform C ABI.  Use these at foreign-call
;; boundaries; ordinary Verona code should normally use the built-in types.
(type c-char i8)
(type c-uchar u8)
(type c-short i16)
(type c-ushort u16)
(type c-int i32)
(type c-uint u32)
(type c-long i64)
(type c-ulong u64)
(type size-t usize)
(type ssize-t isize)
(type off-t i64)
(type pid-t i32)
#+darwin
(type mode-t u16)
#+linux
(type mode-t u32)
(type time-t i64)
(type clock-id-t i32)
(type socket-length-t u32)

;; File descriptors are integer handles.  The following opaque types are only
;; meaningful behind pointers returned to, or accepted from, libc.
(type file-descriptor c-int)
(type c-string (pointer u8))
(type file-stream)
(type directory-stream)
(type file-status)
(type time-specification)
(type socket-address)
(type address-info)
#+darwin
(type pthread-thread (pointer void))
#+linux
(type pthread-thread c-ulong)
(type pthread-mutex)
(type pthread-condition)

;; sockaddr_in has a different family field layout on Darwin and Linux.
;; Initialise its fields in platform-specific application code.
#+darwin
(type ipv4-socket-address
  (product (length u8) (family u8) (port u16) (address u32) (padding (array u8 8))))
#+linux
(type ipv4-socket-address
  (product (family u16) (port u16) (address u32) (padding (array u8 8))))

(export
 c-char c-uchar c-short c-ushort c-int c-uint c-long c-ulong
 size-t ssize-t off-t pid-t mode-t time-t clock-id-t socket-length-t
 file-descriptor c-string file-stream directory-stream file-status
 time-specification socket-address address-info pthread-thread pthread-mutex
 pthread-condition ipv4-socket-address)
